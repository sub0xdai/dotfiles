# Function to find the project root and copy project_index.md
cpi() {
    # Find the root of the git repository
    local root_dir=$(git rev-parse --show-toplevel)

    # Check if a root directory was found
    if [ -z "$root_dir" ]; then
        echo "Error: Not a git repository. Cannot find project root."
        return 1
    fi

    local index_file="$root_dir/project_index.md"

    # Check if the index file exists
    if [ ! -f "$index_file" ]; then
        echo "Error: project_index.md not found in project root ($root_dir)."
        return 1
    fi

    # Copy the file's content to the clipboard
    copyq copy - < "$index_file"
    echo "✅ project_index.md copied to clipboard."
}




#  Open tar or zip
peel() {
  if [ -z "$1" ]; then
    echo "Usage: peel <archive>" >&2
    return 1
  fi

  if [ ! -f "$1" ]; then
    echo "peel: '$1' not found" >&2
    return 1
  fi

  if [[ "$1" == *.zip ]]; then
    unzip "$1"
  else
    tar xf "$1"
  fi
}

# New typst doc — scaffolds a math note using the @local stoic AMOLED template
# Usage: typnote [filename]  (defaults to main.typ)
# Theme lives at ~/.cache/typst/packages/local/stoic/1.0.0/
typnote() {
  local filename="${1:-main.typ}"
  [[ "$filename" != *.typ ]] && filename="${filename}.typ"

  if [[ ! -f "$filename" ]]; then
    cat > "$filename" << 'EOF'
#import "@local/stoic:1.0.0": stoic-doc
#show: stoic-doc

=
EOF
  fi
  nvim "$filename"
}
# Git remote set functions
git_sub0x() {
    REPO=${1:-$(basename $(pwd))}
    git remote set-url origin git@github-sub0xdai:sub0xdai/$REPO.git
}

migrate_repo() {
    echo "Target (1: sub0xdai-git, 2: tehuti-git):"
    read choice
    
    target_dir="$HOME/1-projects/"
    target_user=""
    target_email=""
    
    if [ "$choice" = "1" ]; then
        target_dir+="sub0xdai-git"
        target_user="sub0xdai"
        target_email="$SUB0X_EMAIL"
    else
        target_dir+="tehuti-git"
        target_user="tehuticode"
        target_email="$TEHUTI_EMAIL"
    fi

    mv "$1" "$target_dir/"
    cd "$target_dir/$1"
    git config --local user.name "$target_user"
    git config --local user.email "$target_email"
}

# Dir colors for traditional ls
