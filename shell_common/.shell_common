# Session picker — sesh + fzf entry point (works outside tmux)
# Tokyo Night palette
t() {
  sesh connect "$(
    sesh list -i | fzf \
      --ansi --no-sort --no-multi \
      --prompt '  ' \
      --pointer '▌' \
      --color 'fg:#a9b1d6,bg:-1,hl:#7aa2f7,fg+:#c0caf5,bg+:#292e42,hl+:#7dcfff' \
      --color 'info:#e0af68,prompt:#bb9af7,pointer:#7dcfff,marker:#9ece6a,spinner:#bb9af7' \
      --color 'border:#414868,label:#c0caf5,header:#7aa2f7' \
      --layout reverse \
      --height 60% \
      --border rounded \
      --border-label ' sesh ' \
      --border-label-pos 2 \
      --padding 1 \
      --margin 1 \
      --bind 'tab:down,btab:up' \
      --bind 'esc:abort'
  )"
}


# Yazi shell wrapper
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}

# Reload shell configuration files
reload() {
    # exec replaces current shell process — no hook duplication, pristine state
    if [ -n "$ZSH_VERSION" ]; then
        exec zsh -l
    else
        exec bash -l
    fi
}

# Shows installed packages in order of newest to oldest
packages-by-date() {
  pacman -Qi |
  grep '^\(Name\|Install Date\)\s*:' |
  cut -d ':' -f 2- |
  paste - - |
  while read pkg_name install_date
  do
  install_date=$(date --date="$install_date" -Iseconds)   
  echo "$install_date   $pkg_name"
  done | sort
}

# Common functions
zk() {
    echo -n "title: "
    read filename
    nvim ~/1-projects/vaults/sub0x_vault/0-zettel/"$filename".md
}

# Daily note path under 5-journal/YYYY/; renders 6-templates/daily.md when missing.
_znote() {
    local vault=~/1-projects/vaults/sub0x_vault
    local year=$(date +%Y)
    local today=$(date +%Y-%m-%d)
    local note="$vault/5-journal/$year/$today.md"
    local tpl="$vault/6-templates/daily.md"

    if [ ! -f "$note" ] && [ -f "$tpl" ]; then
        local moment_re="<% moment(tp.file.title, 'YYYY-MM-DD').format(\"dddd, DD MMMM YYYY\") %>"
        local uuid=$(uuidgen 2>/dev/null || cat /proc/sys/kernel/random/uuid)
        mkdir -p "$vault/5-journal/$year"
        sed -e "s|<% tp.file.title %>|$today|g" \
            -e "s|$moment_re|$(date +'%A, %d %B %Y')|" \
            -e "s|<% tp.date.now(\"YYYY-MM-DD\", -1) %>|$(date -d yesterday +%F)|" \
            -e "s|<% tp.date.now(\"YYYY-MM-DD\", +1) %>|$(date -d tomorrow +%F)|" \
            -e "s|^id: *$|id: $uuid|" \
            "$tpl" > "$note"
        if [ ! -s "$note" ]; then
            command rm -f "$note"
            echo "❌ Template render failed: $tpl" >&2
            return 1
        fi
    fi

    printf '%s' "$note"
}

# Insert bullet $3 under the first line equal to $2; drop a bare placeholder below it.
_zbullet() {
    local note="$1" header="$2" bullet="$3"

    if ! grep -qF "$header" "$note" 2>/dev/null; then
        echo "❌ No '$header' callout in $note" >&2
        return 1
    fi

    awk -v hdr="$header" -v bullet="$bullet" '
        found { if ($0 == "- " || $0 == "- [ ] ") next; found = 0 }
        { print }
        $0 == hdr && !done { print bullet; done = 1; found = 1 }
    ' "$note" > "$note.tmp" && command mv -- "$note.tmp" "$note" || return 1

    echo "✅ Added to $(basename "$note")"
}

zkl() {
    echo -n "Log: "
    read -r log_entry
    _zbullet "$(_znote)" '> [!NOTE] Log' "- $log_entry"
}

zkt() {
    echo -n "Task: "
    read -r task_item
    _zbullet "$(_znote)" '> [!tldr] Task' "- [ ] $task_item"
}

create_daily_note() {
    nvim "$(_znote)"
}



