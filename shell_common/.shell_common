# Path — single consolidated block
# Lazy cache ruby gem path (avoids subprocess on every shell init)
_gem_cache="$HOME/.cache/gem_user_dir"
if [[ ! -f "$_gem_cache" ]]; then
  mkdir -p "$HOME/.cache"
  ruby -e 'print Gem.user_dir' > "$_gem_cache" 2>/dev/null
fi
GEM_USER_DIR=$(<"$_gem_cache")

